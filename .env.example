# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_WEBHOOK_SECRET=some-long-random-string-you-choose

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini   # or gpt-4.1-nano — check current model names at platform.openai.com

# Supabase / Postgres (direct connection string — NOT the REST URL)
# Format: postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Your own Telegram user ID (find it via @userinfobot on Telegram)
ALLOWED_TELEGRAM_USER_ID=123456789

# Timezone (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# --- Only needed when running setup_webhook.py ---
# KOYEB_URL=https://your-app-name.koyeb.app
